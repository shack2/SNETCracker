<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>2.0.1</Version>                <!-- 更新服务按此语义化版本比较（config/update.ini 配置服务地址） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
	  <PublishAot>true</PublishAot>          <!-- 启用 Native AOT -->
	  <!-- 编译绑定：AOT 下反射绑定会失效，且编译期即可暴露错误绑定路径 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon />
    <StartupObject />
  </PropertyGroup>

  <!-- AOT 体积优化：裁剪运行时固定成本（exe 61.9MB → 预期 42~48MB） -->
  <PropertyGroup>
    <!-- 只内嵌预定义区域数据（含 zh-CN），不装完整 ICU；Semi 主题需要 zh-CN -->
    <PredefinedCulturesOnly>true</PredefinedCulturesOnly>
    <!-- 去掉调试器支持（发布版不需要） -->
    <DebuggerSupport>false</DebuggerSupport>
    <!-- 去掉 ETW/EventSource 事件管道 -->
    <EventSourceSupport>false</EventSourceSupport>
    <!-- 代码生成偏向体积而非速度（网络工具瓶颈在 IO，不在 CPU） -->
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <!-- 链接期折叠相同方法体（泛型展开去重） -->
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <!-- 去掉异常堆栈格式化（排障靠运行日志） -->
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- 允许 TestRun 访问 internal 编解码器（Ber/Bin/CredentialExpander）做纯单元测试 -->
    <InternalsVisibleTo Include="TestRun" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="res\imgs\**\*.png" />
    <AvaloniaResource Include="res\imgs\**\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <None Include="config\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 协议检测核心（含扫描引擎）已抽为独立库 shack2.pass.checker：全协议自实现、零 UI 依赖 -->
    <ProjectReference Include="..\shack2.pass.checker\shack2.pass.checker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Redis/FTP/SMTP/POP3/IMAP 均已改为自实现最小客户端（Checker/TextProto.cs 等），
         不再引用 StackExchange.Redis / FluentFTP / MailKit -->
    <!-- SQL Server 已改为自实现最小客户端（Checker/TdsWire.cs），不再引用 Microsoft.Data.SqlClient（含原生 SNI.dll） -->
    <!-- MongoDB 已改为自实现最小客户端（Checker/MongoWire.cs），不再引用 MongoDB.Driver -->
    <!-- MySQL 已改为自实现最小客户端（Checker/MySqlWire.cs），不再引用 MySqlConnector -->
    <!-- SSH 已改为自实现最小客户端（Checker/SshWire.cs），不再引用 SSH.NET（连带移除 BouncyCastle） -->
    <!-- PostgreSQL 已改为自实现最小客户端（Checker/PostgresWire.cs），不再引用 Npgsql -->
    <!-- Oracle 已改为自实现最小客户端（Checker/OracleWire.cs），不再引用 Oracle.ManagedDataAccess.Core -->
    <!-- RdpVerify.Lib / SMBLibrary 随协议层迁入 shack2.pass.checker 库 -->
  </ItemGroup>

</Project>
