<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- 命令行版本工具：供脚本 / AI 智能体调用，短小可执行文件名 -->
    <AssemblyName>spc</AssemblyName>
    <Version>2.0.1</Version>
    <RootNamespace>SPasswordCheckerV2.Cmd</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\shack2.pass.checker\shack2.pass.checker.csproj" />
  </ItemGroup>

  <!-- 与 UI 共用同一份配置（服务端口 + 服务字典），单一数据源 -->
  <ItemGroup>
    <None Include="..\SPasswordCheckerV2\config\**\*.*" Link="config\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
